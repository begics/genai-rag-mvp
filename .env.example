DATABASE_URL=jdbc:postgresql://localhost:5432/rag
DATABASE_USERNAME=rag
DATABASE_PASSWORD=change-me
# Local Keycloak master admin and seeded RAG realm admin (ROLE_ADMIN).
# The app user has this username/password; replace the password before startup.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN_EMAIL=admin@example.local
KEYCLOAK_ADMIN_FIRST_NAME=RAG
KEYCLOAK_ADMIN_LAST_NAME=Administrator
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Optional Cloudflare Tunnel token; required to start the cloudflared Compose profile.
CLOUDFLARED_TUNNEL_TOKEN=
# Local S3-compatible storage (RustFS)
S3_ACCESS_KEY=replace-with-a-unique-access-key
S3_SECRET_KEY=replace-with-a-long-random-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rag-documents
# Infomaniak AI Services
RAG_PROVIDER=infomaniak
# For a fully local text RAG stack, use RAG_PROVIDER=ollama. Gemma handles chat,
# planning, screening, invoice extraction, and grounding checks. A separate
# cross-encoder model handles reranking.
# Embeddings use a separate Ollama embedding model. EmbeddingGemma 2 produces
# 768-dimensional vectors. Audio/video transcription remains
# unavailable in local Ollama mode.
# RAG_PROVIDER=ollama
# RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# RAG_OLLAMA_CHAT_MODEL=gemma4:12b-mlx
# Ollama context window (1024-131072, subject to model and available memory).
# RAG_OLLAMA_CONTEXT_TOKENS=32768
# RAG_OLLAMA_EMBEDDING_MODEL=embeddinggemma-2
# To use Infomaniak-hosted Qwen reranking with local Ollama chat/embeddings:
# RAG_OLLAMA_RERANK_PROVIDER=infomaniak
# INFOMANIAK_AI_API_KEY=replace-with-your-infomaniak-api-token
# INFOMANIAK_AI_PRODUCT_ID=replace-with-your-ai-services-product-id
# INFOMANIAK_AI_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# The reranking query and passages are sent to Infomaniak after limited PII masking.
# RAG_OLLAMA_REQUEST_TIMEOUT_MS=180000
# RAG_EMBEDDING_DIMENSIONS=768
# For RAG_PROVIDER=offline, optionally use local Ollama only for agent planning:
# RAG_OFFLINE_AGENT_PLANNER=ollama
# RAG_OFFLINE_AGENT_PLANNER_BASE_URL=http://host.docker.internal:11434
# RAG_OFFLINE_AGENT_PLANNER_MODEL=gemma4:31b
# RAG_OFFLINE_AGENT_PLANNER_TIMEOUT_MS=180000
RAG_GUARDRAILS_DENIED_TOPICS=
RAG_GUARDRAILS_MAX_COMPLETION_TOKENS=512
INFOMANIAK_AI_API_KEY=replace-with-your-infomaniak-api-token
INFOMANIAK_AI_PRODUCT_ID=replace-with-your-ai-services-product-id
INFOMANIAK_AI_CHAT_MODEL=replace-with-a-chat-model-id
# Used only for bounded agent planning; answer generation keeps the chat model above.
INFOMANIAK_AI_AGENT_PLANNER_MODEL=google/gemma-4-31B-it
INFOMANIAK_AI_EMBEDDING_MODEL=bge_multilingual_gemma2
INFOMANIAK_AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_PROVIDER_MAX_CONCURRENT_CALLS=8
# Per-instance query-cache limits; Redis shares entries across app replicas.
RAG_CACHE_MAX_ENTRIES=1000
RAG_CACHE_TTL_SECONDS=300
# Redis is private to the Compose network; memory is bounded and cache data is ephemeral.
RAG_CACHE_REDIS_MAX_MEMORY=128mb
RAG_CACHE_REDIS_CONNECT_TIMEOUT=500ms
RAG_CACHE_REDIS_TIMEOUT=500ms
INFOMANIAK_AI_REQUEST_TIMEOUT_MS=60000
INFOMANIAK_AI_CONNECT_TIMEOUT_MS=10000
INFOMANIAK_AI_READ_TIMEOUT_MS=60000
INFOMANIAK_AI_MAX_RETRIES=1
INFOMANIAK_AI_TRANSCRIPTION_POLL_INTERVAL_MS=2000
INFOMANIAK_AI_TRANSCRIPTION_TIMEOUT_MS=300000
RAG_EMBEDDING_DIMENSIONS=3584
